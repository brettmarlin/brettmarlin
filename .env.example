# Where the site finds its Worker (recipient views, gated studies, admin).
# Empty means same origin: in dev the Vite proxy forwards /api and /images to
# scripts/dev-api.mjs on :8787; in production either route the Worker on the
# site's own domain or set the workers.dev URL here.
VITE_API_BASE=
# Dev only: serve case-study images from the vault's _attachments folder (and
# dimension-true placeholders for the rest) instead of the remote image origin.
VITE_LOCAL_IMAGES=0
# Where the vault is checked out, for generate, clearance and local images.
VAULT_DIR=
# PostHog, optional. The same project the previous site used. No key, no analytics.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
