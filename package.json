{
  "name": "brettmarlin-xyz",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "brettmarlin.xyz: the portfolio of Brett Marlin. Swiss grid, vault-driven case studies, password-protected recipient views, and an admin panel on a Cloudflare Worker.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test scripts/*.test.mjs worker/src/*.test.mjs tests/*.test.mjs",
    "copy:check": "node scripts/check-copy.mjs",
    "bundle:check": "node scripts/check-public-bundle.mjs",
    "clearance:check": "node scripts/check-clearance.mjs",
    "clearance": "node scripts/clearance-report.mjs",
    "dist:check": "node scripts/check-dist.mjs",
    "build": "npm run copy:check && npm run bundle:check && npm run clearance:check && npm run typecheck && vite build && npm run dist:check",
    "build:preview": "npm run typecheck && vite build",
    "preview": "vite preview",
    "generate": "node scripts/generate-case-studies.mjs",
    "generate:check": "node scripts/generate-case-studies.mjs --check",
    "generate:offline": "node --import ./scripts/offline-image-list.mjs scripts/generate-case-studies.mjs",
    "substack": "node scripts/generate-substack.mjs",
    "substack:check": "node scripts/generate-substack.mjs --check",
    "taxonomy": "node scripts/build-taxonomy-ts.mjs",
    "taxonomy:check": "node scripts/check-taxonomy.mjs",
    "reorder": "node scripts/reorder-studies.mjs",
    "order:check": "node scripts/reorder-studies.mjs --check",
    "gated:publish": "node scripts/publish-gated-study.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "axe": "node scripts/verify-axe.mjs",
    "og": "node scripts/og-image.mjs",
    "verify": "node scripts/verify.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "motion": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.3",
    "playwright-core": "^1.50.0",
    "typescript": "^5.7.2",
    "vite": "^6.3.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
